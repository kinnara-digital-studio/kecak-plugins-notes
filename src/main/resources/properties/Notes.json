[
  {
    "title": "Notes",
    "properties": [
      {
        "name": "id",
        "label": "ID",
        "type": "textfield",
        "required": "True",
        "regex_validation": "^[a-zA-Z0-9_]+$",
        "validation_message": "@@form.notesfield.invalidId@@"
      },
      {
        "name": "label",
        "label": "Label",
        "type": "textfield",
        "value": "Notes Field"
      },
      {
        "name": "readonly",
        "label": "Read Only",
        "type": "checkbox",
        "options": [
          {
            "value": "true",
            "label": "readonly"
          }
        ]
      },
      {
        "name": "readonlyLabel",
        "label": "readonly as Label",
        "type": "checkbox",
        "options": [
          {
            "value": "true",
            "label": "readonlyLabel"
          }
        ]
      },
      {
        "label": "Data Binder",
        "type": "header"
      },
      {
        "name": "loadBinder",
        "label": "Load Binder",
        "type": "elementselect",
        "options_ajax": "[CONTEXT_PATH]/web/property/json/getElements?classname=org.joget.apps.form.model.FormLoadElementBinder",
        "url": "[CONTEXT_PATH]/web/property/json[APP_PATH]/getPropertyOptions",
        "value": "%s"
      },
      {
        "name": "storeBinder",
        "label": "Store Binder",
        "type": "elementselect",
        "options_ajax": "[CONTEXT_PATH]/web/property/json/getElements?classname=org.joget.apps.form.model.FormStoreElementBinder",
        "url": "[CONTEXT_PATH]/web/property/json[APP_PATH]/getPropertyOptions",
        "value": "%s"
      },
      {
        "name": "notesFormDefId",
        "label": "Notes Form ID",
        "type": "textfield",
        "description": "Form ID tabel notes terpisah (contoh: t_notes_table)"
      }
    ]
  }
]